{
  "mcpServers": {
    "yugo-memory": {
      "command": "python3",
      "args": [
        "./scripts/recall_mcp.py"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "XDG_CONFIG_HOME",
        "YUGO_MEMORY_HOME",
        "YUGO_MEMORY_ARCHIVE_DIR",
        "YUGO_MEMORY_INDEX_DB",
        "YUGO_MEMORY_CONTROL_DB",
        "YUGO_MEMORY_INCLUDE_QODER",
        "YUGO_MEMORY_QODER_SOURCE_DIR"
      ]
    }
  }
}
